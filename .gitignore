# --- pixi environment (rebuilt from pixi.lock; never commit) --------------
.pixi/
.pixi-cache/

# --- analysis outputs ----------------------------------------------------
output_raw/
*.parquet

# --- generated / cached inputs -------------------------------------------
# ntuples.json is a cache of the CMS Open Data file indexes. It is
# regenerated by the notebook and can go stale, so it is not committed.
ntuples.json
Cert_*_JSON.txt

# --- notebook noise ------------------------------------------------------
.ipynb_checkpoints/
.virtual_documents/
_smoke_test.ipynb
_smoke_ah.ipynb
.sl_source.md

# --- redirected caches (see [activation.env] in pixi.toml) ---------------
.jupyter/
.cache/
.smoke.log
.smoke_ah.log
.jupyter.log

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
runs/
_run_*.ipynb

# --- not for redistribution ------------------------------------------------
# CMS analysis notes are collaboration-internal (see the note's own cover
# page). Ask a DPOA mentor for a copy; do not commit it.
analysisis_notes.pdf

# --- internal report builder (make_report.py) -----------------------------
_report_scratch/
